#!/bin/bash
set -euo pipefail

# Usage: bin/push-deb [file.deb ...]
# Uploads the .deb files from the last build (or the ones given) to packagecloud.
#
# PACKAGECLOUD_TOKEN              API token
# PACKAGECLOUD_DISTRO_VERSION_ID  packagecloud's numeric id for the target OS release
#                                 (e.g. Debian bookworm or trixie); see
#                                 https://packagecloud.io/docs/api#resource_distributions
# PACKAGECLOUD_REPO               defaults to mimeindustries/headlesspi

: "${PACKAGECLOUD_TOKEN:?Set PACKAGECLOUD_TOKEN first}"
: "${PACKAGECLOUD_DISTRO_VERSION_ID:?Set PACKAGECLOUD_DISTRO_VERSION_ID to the packagecloud id for the target OS release}"
REPO="${PACKAGECLOUD_REPO:-mimeindustries/headlesspi}"

if [ "$#" -gt 0 ]; then
  DEBFILES=("$@")
else
  mapfile -t DEBFILES < <(grep -oP '^\S+\.deb' debian/files | grep -v dbgsym | sed 's|^|../|')
fi

for DEBFILE in "${DEBFILES[@]}"; do
  echo "Pushing $DEBFILE"
  # Pass the token via a config on stdin so it doesn't show up in the process list
  printf 'user = "%s:"\n' "$PACKAGECLOUD_TOKEN" | curl --fail -sS -K - \
    -X POST "https://packagecloud.io/api/v1/repos/${REPO}/packages.json" \
    --form-string "package[distro_version_id]=${PACKAGECLOUD_DISTRO_VERSION_ID}" \
    -F "package[package_file]=@${DEBFILE}"
  echo
done
