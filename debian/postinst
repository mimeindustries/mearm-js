#!/bin/bash
set -e

if [ "$1" = "configure" ]; then
  # Load the i2c-dev module at boot if it isn't already configured
  if ! grep -q '^i2c-dev' /etc/modules 2>/dev/null; then
    echo "Enabling I2C"
    echo "i2c-dev" >> /etc/modules
    modprobe i2c-dev 2>/dev/null || true
  fi

  # Enable the I2C interface in the firmware config (newer OS images use /boot/firmware)
  for CONFIG in /boot/firmware/config.txt /boot/config.txt; do
    if [ -f "$CONFIG" ]; then
      if grep -q '^#\s*dtparam=i2c_arm=on' "$CONFIG"; then
        sed -i 's/^#\s*dtparam=i2c_arm=on/dtparam=i2c_arm=on/' "$CONFIG"
      elif ! grep -q '^dtparam=i2c_arm=on' "$CONFIG"; then
        echo "dtparam=i2c_arm=on" >> "$CONFIG"
      fi
      break
    fi
  done
fi

# Generated by debhelper: enables and starts mearm-control.service
#DEBHELPER#

exit 0
