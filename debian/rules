#!/usr/bin/make -f

DISTRIBUTION = $(shell lsb_release -sr)
#VERSION = <passed in by VERSION environment variable>
APPNAME = mearm-control
PACKAGEVERSION = $(VERSION)
INSTALLDIR = debian/${APPNAME}/opt/${APPNAME}

%:
	dh $@

override_dh_auto_clean:
	rm -rf debian/${APPNAME}
override_dh_auto_test:
override_dh_usrlocal:
override_dh_auto_build:
override_dh_auto_install:
	mkdir -p $(INSTALLDIR)
	rsync -av . $(INSTALLDIR) --exclude debian --exclude .git --exclude node_modules --exclude .gitignore --exclude test
	cd $(INSTALLDIR) && npm install --production --no-audit --no-fund

override_dh_gencontrol:
	dh_gencontrol -- -v$(PACKAGEVERSION)
